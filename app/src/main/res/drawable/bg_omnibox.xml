<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: soft tonal fill with a primary ring -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface_container_high" />
            <corners android:radius="26dp" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>
    <!-- Default: pill on tonal fill, no outline -->
    <item>
        <shape>
            <solid android:color="@color/surface_container_high" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/surface_container_high" />
        </shape>
    </item>
</selector>
