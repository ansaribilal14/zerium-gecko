<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome-style tab group card for the main tab overview: one compact card
     per group (coloured strip, name chip row, member preview tiles). Tapping
     opens the dedicated group-detail grid; long-press opens the group
     overflow menu. The card is also a drag/drop target for grouping. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/groupCard"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="22dp"
    app:cardBackgroundColor="@color/surface_container_low"
    app:cardElevation="0dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Group colour strip (the card's identity in the grid). -->
        <View
            android:id="@+id/groupStrip"
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <View
                android:id="@+id/grpDot"
                android:layout_width="12dp"
                android:layout_height="12dp" />

            <TextView
                android:id="@+id/grpName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/grpCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Up to four member page previews; missing previews render as
             neutral tiles so the card keeps its shape. -->
        <LinearLayout
            android:id="@+id/groupTiles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
