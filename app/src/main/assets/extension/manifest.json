{
  "manifest_version": 2,
  "name": "Zerium G Shield",
  "version": "1.2.0",
  "description": "Engine-level ad and tracker blocking for Zerium G: network request filtering with an Adblock-syntax subset, YouTube InnerTube pruning, cosmetic element hiding and reader-view extraction.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "downloads",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "content/yt-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/readability.js",
        "content/reader.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/media-scan.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    "page/yt-block.js"
  ]
}